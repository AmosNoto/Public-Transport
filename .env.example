# Afterglow server configuration. Copy to .env and fill in what you have.
# Every key is optional: cities whose feeds need no key work without any.
# See KEYS.md for what each key unlocks and where to sign up.

# HTTP/WebSocket port for the server (the Vite dev client proxies to it).
PORT=8787
# Where downloaded and preprocessed feed data is cached.
CACHE_DIR=./data/cache
# How often (seconds) to poll a realtime feed someone is watching. Feeds may set a slower rate.
POLL_INTERVAL_S=10
# How often (seconds) to poll feeds nobody is watching (they still drive the globe and counters).
IDLE_POLL_INTERVAL_S=30
# Discover feeds from the Mobility Database catalog. Set to off for the curated cities only
# (a much smaller server: no background downloads, ~300 MB of memory).
CATALOG=on
# Skip catalog timetables larger than this (MB, zipped). Curated cities are exempt.
MAX_STATIC_MB=200
# Memory limit (MB) for each background timetable build; bigger ones are skipped, not crashed on.
BUILD_MEMORY_MB=1536
# Contact string sent in the User-Agent so agencies can reach you about traffic.
USER_AGENT_CONTACT=
# Diagnostics: comma-separated feed ids to show from the timetable instead of live data.
# FORCE_SCHEDULED=mbta

# API keys for feeds that need one: one variable per API host. Generated list with sign-up
# links: KEYS.md (refresh it with `npm run keys`). For example:
# KEY_API_511_ORG=          (San Francisco Bay Area, ~38 agencies; https://511.org/open-data/token)
# KEY_API_GOSWIFT_LY=
# KEY_OPENDATA_SAMTRAFIKEN_SE=
